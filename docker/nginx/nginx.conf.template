worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format astor '$remote_addr - $request_id [$time_local] '
                     '"$request" $status $body_bytes_sent '
                     'rt=$request_time uct=$upstream_connect_time '
                     'uht=$upstream_header_time urt=$upstream_response_time';

    access_log /var/log/nginx/access.log astor;
    error_log /var/log/nginx/error.log warn;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 20m;

    # Behind the Cloud.ru edge proxy (Caddy on the docker network `edge`) every request
    # arrives from one container IP; without this the rate limits below would be shared
    # by all visitors. Only private docker ranges are trusted to set the forwarded headers.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    map $http_x_forwarded_proto $astor_forwarded_proto {
        default $scheme;
        https   https;
    }

    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=swagger_limit:10m rate=3r/s;

    upstream astor_backend {
        least_conn;
        server ${ASTOR_BACKEND_UPSTREAM} max_fails=3 fail_timeout=10s;
        keepalive 32;

        # Production target shape:
        # server astor-app-1:8088 max_fails=3 fail_timeout=10s;
        # server astor-app-2:8088 max_fails=3 fail_timeout=10s;
        # server astor-app-3:8088 max_fails=3 fail_timeout=10s;
    }

    server {
        listen 8080;
        server_name _;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $astor_forwarded_proto;
        proxy_set_header Connection "";

        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        location = /gateway/health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "api-gateway: ok\n";
        }

        location = / {
            return 302 /swagger-ui/index.html;
        }

        location /swagger-ui/ {
            limit_req zone=swagger_limit burst=10 nodelay;
            proxy_pass http://astor_backend;
        }

        location /v3/api-docs {
            limit_req zone=swagger_limit burst=10 nodelay;
            proxy_pass http://astor_backend;
        }

        # Public Butler API: the same allow-list as the edge (infra/cloudru/edge/c3ag.caddy,
        # docs/operations/PUBLIC_API_GUARD.md). Everything else under /api/ and /actuator/ is internal
        # and is forwarded only when the caller carries X-Astor-Internal-Token (the bot checks its value);
        # anonymous callers get 404, so the gateway is not a second public door when it is published directly.
        location = /api/messages {
            limit_req zone=api_limit burst=30 nodelay;
            proxy_pass http://astor_backend;
        }

        location /api/astor/ {
            limit_req zone=api_limit burst=30 nodelay;
            proxy_pass http://astor_backend;
        }

        location /api/chat/ {
            limit_req zone=api_limit burst=30 nodelay;
            proxy_pass http://astor_backend;
        }

        location /api/glasses/ {
            limit_req zone=api_limit burst=30 nodelay;
            proxy_pass http://astor_backend;
        }

        location /api/staff/ {
            limit_req zone=api_limit burst=30 nodelay;
            proxy_pass http://astor_backend;
        }

        location /api/admin/staff {
            limit_req zone=api_limit burst=30 nodelay;
            proxy_pass http://astor_backend;
        }

        location /api/auth/ {
            limit_req zone=api_limit burst=30 nodelay;
            proxy_pass http://astor_backend;
        }

        location = /actuator/health {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://astor_backend;
        }

        # Prometheus 2.x (docker/prometheus/prometheus.yml) scrapes through this gateway and cannot add headers;
        # the edge never forwards /actuator/*, so this stays reachable from the docker network only.
        location = /actuator/prometheus {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://astor_backend;
        }

        location /actuator/ {
            if ($http_x_astor_internal_token = "") {
                return 404;
            }
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://astor_backend;
        }

        location /api/ {
            if ($http_x_astor_internal_token = "") {
                return 404;
            }
            limit_req zone=api_limit burst=30 nodelay;
            proxy_pass http://astor_backend;
        }

        location /auth/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://astor_backend;
        }

        location / {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://astor_backend;
        }
    }
}
