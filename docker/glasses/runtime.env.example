# Glasses runtime env (docker/glasses/compose.yaml -> env_file). Copy to /opt/astor-glasses/private/runtime.env,
# root 0600, fill the secrets there. Never commit the filled file. Only variables the STT/model switch needs are
# listed; access, S3 and TTS settings are documented in docs/operations/GLASSES_ASSIST_PILOT.md.

# --- speech-to-text: Yandex SpeechKit v1 (image docker/glasses/Dockerfile.cloud, ffmpeg inside) ---
# The phone's MP4/AAC is transcoded to Ogg Opus 16 kHz mono by ffmpeg in the container, then sent to SpeechKit.
ASTOR_GLASSES_VOICE_ENABLED=true
ASTOR_GLASSES_STT_PROVIDER=yandex
YANDEX_SPEECHKIT_API_KEY=<Api-Key of a service account with ai.speechkit-stt.user (and -tts.user for the voice)>
# ASTOR_GLASSES_STT_API_KEY=<Api-Key SpeechKit>     # a separate STT key; empty = YANDEX_SPEECHKIT_API_KEY above
# ASTOR_GLASSES_STT_LANGUAGE=ru                     # goes out as lang=ru-RU
# ASTOR_GLASSES_STT_TIMEOUT_MS=20000                # bounds ffmpeg and the SpeechKit request, max 30000
# ASTOR_GLASSES_FFMPEG=ffmpeg                       # the ffmpeg binary in the image (default: ffmpeg on PATH)
# YANDEX_SPEECHKIT_STT_ENDPOINT=https://stt.api.cloud.yandex.net/speech/v1/stt:recognize

# --- speech-to-text: Cloud.ru whisper-large-v3 (same image, ffmpeg unused; needs Cloud.ru billing) ---
# ASTOR_GLASSES_STT_PROVIDER=cloudru
ASTOR_GLASSES_CLOUDRU_API_KEY=<Cloud.ru API key>    # also the key of ASTOR_GLASSES_AI_PROVIDER=cloudru below
# CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
# ASTOR_GLASSES_STT_CLOUDRU_MODEL=openai/whisper-large-v3

# --- rollback: local faster-whisper (image docker/glasses/Dockerfile, models mounted at /models) ---
# ASTOR_GLASSES_STT_PROVIDER=local
# ASTOR_GLASSES_STT_MODEL_DIR=/models/whisper-base

# --- text/vision models on Cloud.ru (same key) ---
ASTOR_GLASSES_AI_PROVIDER=cloudru                # legacy name: ASTOR_GLASSES_MODEL_PROVIDER
ASTOR_GLASSES_TEXT_MODEL=GigaChat/GigaChat-2-Max
ASTOR_GLASSES_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# --- or GigaChat API directly (Sber key), while Cloud.ru FM is unavailable ---
# ASTOR_GLASSES_AI_PROVIDER=gigachat
# ASTOR_GLASSES_GIGACHAT_AUTH_KEY=<GigaChat Authorization key>   # else GIGACHAT_AUTH_KEY
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_CERT_PATH=/certs/russian_trusted_root_ca.pem      # mounted by compose.cloudru.yaml
# ASTOR_GLASSES_TEXT_MODEL=GigaChat-2-Max                        # a "GigaChat/" prefix is dropped
# ASTOR_GLASSES_VISION_MODEL=GigaChat-2-Max                      # photo goes to /files, attached by id

# --- a task given by voice (docs/operations/GLASSES_VOICE_TASKS.md); off by default ---
# The manager says «Задача: Анне принести воду на пятый стол» (or the phone sends intent "task") and Butler
# creates a staff task. Needs the same ASTOR_GLASSES_RELAY_TOKEN as the transcript relay in both services
# and ASTOR_STAFF_TASKS_ENABLED=true on the bot.
# ASTOR_GLASSES_TASKS_ENABLED=true
# ASTOR_GLASSES_RELAY_TOKEN=<shared with the bot, >= 16 chars>
# ASTOR_GLASSES_STAFF_TASKS_URL=http://aeris-astor-butler-bot:8089/api/internal/glasses/staff-tasks
# ASTOR_GLASSES_TASK_TRIGGER_WORDS=задача,поручение,поручи,передай
# ASTOR_GLASSES_TIMEOUT_MS=20000           # draft (model) + Butler fit comfortably; default 10000
