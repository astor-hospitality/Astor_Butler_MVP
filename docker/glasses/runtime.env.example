# Glasses runtime env (docker/glasses/compose.yaml -> env_file). Copy to /opt/astor-glasses/private/runtime.env,
# root 0600, fill the secrets there. Never commit the filled file. Only variables the STT/model switch needs are
# listed; access, S3 and TTS settings are documented in docs/operations/GLASSES_ASSIST_PILOT.md.

# --- speech-to-text: Cloud.ru whisper-large-v3 (image docker/glasses/Dockerfile.cloud) ---
ASTOR_GLASSES_VOICE_ENABLED=true
ASTOR_GLASSES_STT_PROVIDER=cloudru
ASTOR_GLASSES_CLOUDRU_API_KEY=<Cloud.ru API key>
# CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
# ASTOR_GLASSES_STT_CLOUDRU_MODEL=openai/whisper-large-v3
# ASTOR_GLASSES_STT_LANGUAGE=ru
# ASTOR_GLASSES_STT_TIMEOUT_MS=20000        # whole request, max 30000

# --- rollback: local faster-whisper (image docker/glasses/Dockerfile, models mounted at /models) ---
# ASTOR_GLASSES_STT_PROVIDER=local
# ASTOR_GLASSES_STT_MODEL_DIR=/models/whisper-base

# --- text/vision models on Cloud.ru (same key) ---
ASTOR_GLASSES_MODEL_PROVIDER=cloudru
ASTOR_GLASSES_TEXT_MODEL=GigaChat/GigaChat-2-Max
ASTOR_GLASSES_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
