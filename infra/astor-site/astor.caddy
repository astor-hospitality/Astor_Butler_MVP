# Astor - презентационный сайт (статический контейнер astor-site, compose в infra/astor-site).
# Пока только техническое имя: собственного домена у Astor нет. Когда появится A-запись
# (astor.c3ag.ru или купленный домен), добавить его через запятую в строку адреса ниже
# и сделать validate + reload - сертификат Caddy выпустит сам. Не добавлять имя раньше,
# чем появится A-запись: иначе Caddy будет бесконечно повторять ACME для него.
astor.176-123-165-162.nip.io {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Веб-чат виджета (/api/astor/messages) - тот же gateway, что у c3ag.ru.
	# Если backend не нужен на этом имени, блок можно убрать: сайт работает без него.
	@backend path /api/*
	handle @backend {
		reverse_proxy astor-api-gateway:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		reverse_proxy astor-site:80 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}
