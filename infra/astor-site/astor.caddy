# Astor - презентационный сайт (статический контейнер astor-site, compose в infra/astor-site).
# Пока только техническое имя: собственного домена у Astor нет. Когда появится A-запись
# (astor.c3ag.ru или купленный домен), добавить его через запятую в строку адреса ниже
# и сделать validate + reload - сертификат Caddy выпустит сам. Не добавлять имя раньше,
# чем появится A-запись: иначе Caddy будет бесконечно повторять ACME для него.
astor.176-123-165-162.nip.io {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Веб-чат виджета (docs/architecture/WEB_CHANNEL_ADAPTER.md):
	#   /api/astor/messages     Astor Butler сам (WebChatController) через api-gateway - как /api/astor/* в c3ag.caddy;
	#                           старый relay в контейнере очков (AstorWebRelay) режет ответ до {text} и отклоняет
	#                           поля payload.action/contactPhone/locale, поэтому сюда больше не ведёт.
	#   /api/concierge/messages контейнер Astor Concierge (порт WEB_PORT=8096, сеть edge; Astor_Concierge PR #28).
	#                           НЕ в api-gateway: /api/concierge/** у Butler - внутренний API (InternalApiGuardFilter).
	# Если backend не нужен на этом имени, блоки можно убрать: сайт работает без них.
	@butler_chat path /api/astor/messages
	handle @butler_chat {
		request_body {
			max_size 2MB
		}
		reverse_proxy astor-api-gateway:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	@concierge_chat path /api/concierge/messages
	handle @concierge_chat {
		request_body {
			max_size 2MB
		}
		reverse_proxy astor-concierge-concierge-1:8096 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	@backend path /api/*
	handle @backend {
		reverse_proxy astor-api-gateway:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		reverse_proxy astor-site:80 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}
