# Settings of the staff portal rehearsal scripts. Copy, edit, then `set -a; . ./my.env; set +a`.
# The values below are the local defaults: the compose stack of this folder and the public
# passwords of the repository's docker-compose.yml. Do not write a real password into a file that
# lives in the repository; export it in the shell of the person who runs the rehearsal.

# PostgreSQL server that holds the source base and will hold its copy.
REHEARSAL_PGHOST=postgres
REHEARSAL_PGPORT=5432
REHEARSAL_PGUSER=astor
REHEARSAL_PGPASSWORD=astor
# Base to connect to for CREATE DATABASE and the list of bases.
REHEARSAL_ADMIN_DB=postgres
# Docker network from which REHEARSAL_PGHOST resolves. Leave empty to reach a port published on this
# machine as host.docker.internal:<port>.
REHEARSAL_DOCKER_NETWORK=astor-rehearsal_default

# Source is only read by pg_dump. Everything else happens in the copy.
REHEARSAL_SOURCE_DB=rehearsal_before
REHEARSAL_COPY_DB=rehearsal_copy
# Must repeat the copy's name, or steps 2 to 5 refuse to write.
REHEARSAL_WRITE_TO=rehearsal_copy
# Instead of dumping the source: restore a dump that already exists (pg_dump -Fc), e.g. the nightly one.
#REHEARSAL_DUMP_FILE=/var/backups/astor/daily/astor-pg-YYYYMMDD-HHMMSS.dump

# What is going to be deployed and the changeset the rehearsal is about.
REHEARSAL_TARGET_REF=origin/main
REHEARSAL_CHANGESET_ID=2026-10-05-staff-portal

# Dumps, plans, logs and summaries. Outside the repository.
REHEARSAL_OUT=$HOME/astor-staff-rehearsal-out

# Images. Liquibase must be the version of liquibase-core in pom.xml.
REHEARSAL_PG_IMAGE=pgvector/pgvector:pg16
REHEARSAL_LIQUIBASE_IMAGE=liquibase/liquibase:4.33.0

# Step 1 only (local stand-in for the existing base).
#REHEARSAL_BEFORE_REF=            # default: the parent of the commit that added the changeset
#REHEARSAL_HISTORIC_CHECKSUMS=1   # store the declared validCheckSum values, as the AERIS base has them
#REHEARSAL_PILOT_DIRECTORY=1      # hand-entered staff directory rows (needs a base with the staff tables)

# Step 5 only (local application and Keycloak).
#REHEARSAL_MVN=mvn
#REHEARSAL_PYTHON=python3
#REHEARSAL_APP_PORT=28088
#REHEARSAL_KEYCLOAK_PUBLISHED_PORT=28443
#REHEARSAL_PG_PUBLISHED_PORT=25434
