{
  "realm": "astor",
  "enabled": true,
  "displayName": "Astor",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru",
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "roles": {
    "realm": [
      {
        "name": "astor-waiter",
        "description": "Видит и выполняет только поручения, назначенные лично ему на открытой смене."
      },
      {
        "name": "astor-hostess",
        "description": "Создаёт, переназначает и отменяет поручения своего заведения, видит ленту заведения."
      },
      {
        "name": "astor-manager",
        "description": "То же, что хостес. Отдельная роль оставлена под будущие права: настройки заведения и отчёты."
      }
    ]
  },
  "clients": [
    {
      "clientId": "astor-staff-ui",
      "name": "Кабинет поручений Astor",
      "description": "Публичный клиент кабинета менеджера в браузере. Секрета нет и быть не может: код выполняется в браузере. Поток защищается PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8097/*"
      ],
      "webOrigins": [
        "http://localhost:8097"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8097/*"
      },
      "protocolMappers": [
        {
          "name": "astor-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "astor-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "astor-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "astor-glasses-app",
      "name": "Телефонный клиент очков Astor",
      "description": "Публичный клиент приложения на телефоне официанта. Секрета нет: приложение установлено на устройство. Поток защищается PKCE, адрес возврата задаётся схемой приложения.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "astorglass://oauth/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "astor-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "astor-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "astor-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "astor-api",
      "name": "Astor API (сервер)",
      "description": "Сервер токены не выдаёт, он их проверяет. Клиент заведён затем, чтобы его имя можно было положить в aud выданного токена.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": []
}
